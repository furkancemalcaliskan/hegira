* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.app-root {
    min-height: 100vh;
    background: var(--background);
}

.brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
}

.brand-logo {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    object-fit: contain;
}

.brand-copy {
    display: grid;
    gap: 0.125rem;
}

.brand-copy strong {
    font-size: 0.9rem;
}

.brand-copy small {
    color: var(--muted-foreground);
    font-size: 0.75rem;
}

.wasm-boot-loader {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: grid;
    place-content: center;
    gap: 1rem;
    background: var(--background);
    color: var(--foreground);
    opacity: 1;
    transition: opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 260ms cubic-bezier(0.22, 1, 0.36, 1);
    visibility: visible;
}

.wasm-boot-loader .brand-logo {
    width: 3rem;
    height: 3rem;
    justify-self: center;
}

.wasm-boot-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
}

.wasm-boot-spinner {
    width: 1.75rem;
    height: 1.75rem;
    justify-self: center;
    border: 2px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 999px;
    animation: wasm-boot-spin 800ms linear infinite;
}

@keyframes wasm-boot-spin {
    to {
        transform: rotate(360deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    .wasm-boot-loader {
        transition: none;
    }

    .wasm-boot-spinner {
        animation: none;
    }
}

.workspace-layout {
    --sidebar-width: 18rem;
    display: grid;
    min-height: 100vh;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
}

.workspace-layout.is-sidebar-collapsed {
    --sidebar-width: 5.75rem;
}

.workspace-main {
    min-width: 0;
    background: var(--background);
}

.workspace-content {
    width: min(100%, 96rem);
    margin: 0 auto;
    padding: 1.5rem;
}

.route-fade {
    animation: route-fade-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: opacity;
}

@keyframes route-fade-in {
    from {
        opacity: 0.35;
    }

    to {
        opacity: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    .route-fade {
        animation: none;
    }
}

.app-sidebar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    width: 18rem;
    height: 100vh;
    flex-direction: column;
    overflow: visible;
    border-right: 1px solid var(--border);
    background: var(--card);
    color: var(--card-foreground);
    transition: width 0.2s ease, box-shadow 0.2s ease;
}

.workspace-layout.is-sidebar-collapsed .app-sidebar {
    width: var(--sidebar-width);
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded {
    width: 18rem;
    box-shadow: 0 12px 32px color-mix(in oklab, var(--foreground) 14%, transparent);
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded .sidebar-link span {
    display: inline;
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded .sidebar-search {
    display: block;
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded .sidebar-version {
    display: grid;
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded .sidebar-section h2 {
    display: block;
}

.brand-shell {
    display: flex;
    height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
}

.brand-shell.is-collapsed {
    justify-content: center;
}

.brand-shell.is-collapsed .brand-copy,
.workspace-layout.is-sidebar-collapsed .sidebar-search,
.workspace-layout.is-sidebar-collapsed .sidebar-version,
.workspace-layout.is-sidebar-collapsed .sidebar-link span,
.workspace-layout.is-sidebar-collapsed .sidebar-section h2 {
    display: none;
}

.sidebar-collapse {
    flex: 0 0 auto;
}

.sidebar-search {
    position: relative;
    margin: 1rem 1rem 1rem;
}

.sidebar-nav {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    padding: 0 1rem 1.5rem;
}

.sidebar-version {
    display: grid;
    gap: 0.125rem;
    margin: auto 1rem 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    padding-top: 1rem;
}

.sidebar-version strong {
    color: var(--foreground);
    font-size: 0.8125rem;
}

.sidebar-version small {
    font-size: 0.75rem;
}

.sidebar-section h2 {
    margin: 0 0 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.sidebar-items {
    display: grid;
    gap: 0.25rem;
}

.sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.5rem;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 650;
    padding: 0.625rem 0.75rem;
}

.sidebar-link:hover,
.sidebar-link.is-active {
    background: var(--accent);
    color: var(--primary);
}

.workspace-layout.is-sidebar-collapsed .sidebar-link {
    justify-content: center;
}

.workspace-layout.is-sidebar-collapsed .app-sidebar.is-hover-expanded .sidebar-link {
    justify-content: flex-start;
}

.topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--background) 92%, transparent);
    padding: 0.875rem 1.5rem;
    backdrop-filter: blur(16px);
}

.topbar-title {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
}

.topbar-menu-button {
    display: none;
}

.topbar-title h1 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
}

.topbar-title ol {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin: 0;
    padding: 0;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    list-style: none;
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
}

.account-menu {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px) scale(0.96);
    transform-origin: top right;
    transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1), visibility 180ms;
    visibility: hidden;
}

.account-menu.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    visibility: visible;
}

.modal-overlay {
    opacity: 0;
    transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1), visibility 180ms;
    visibility: hidden;
}

.modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
}

.modal-panel {
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

.modal-panel.is-open {
    opacity: 1;
    transform: scale(1);
}

.filter-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    overflow: hidden;
    transition: grid-template-rows 200ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.filter-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
}

.filter-panel > div {
    min-height: 0;
    overflow: hidden;
}

.account-avatar {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.8125rem;
    font-weight: 800;
}

.account-avatar.is-large {
    width: 3rem;
    height: 3rem;
}

.page-stack {
    display: grid;
    gap: 1.25rem;
}

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
}

.page-header h1 {
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.2;
}

.page-header p,
.page-section p,
.profile-summary p {
    margin: 0.35rem 0 0;
    color: var(--muted-foreground);
}

.page-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.page-section {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
    color: var(--card-foreground);
    padding: 1.25rem;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--foreground) 8%, transparent);
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
}

.metric-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.metric-value {
    display: block;
    margin-top: 0.75rem;
    font-size: 1.5rem;
}

.web-empty-state,
.web-loading,
.web-placeholder {
    color: var(--muted-foreground);
}

.profile-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.profile-summary h2 {
    margin: 0;
}

.sidebar-scrim {
    display: none;
}

@media (max-width: 1023px) {
    .workspace-layout,
    .workspace-layout.is-sidebar-collapsed {
        display: block;
    }

    .app-sidebar {
        position: fixed;
        left: 0;
        transform: translateX(-100%);
        width: min(18rem, 88vw);
        transition: transform 0.2s ease;
    }

    .app-sidebar.is-open {
        transform: translateX(0);
    }

    .sidebar-scrim {
        position: fixed;
        inset: 0;
        z-index: 25;
        display: block;
        border: 0;
        background: color-mix(in oklab, var(--foreground) 42%, transparent);
    }

    .sidebar-collapse {
        display: none;
    }

    .topbar-menu-button {
        display: inline-flex;
    }

    .workspace-content {
        padding: 1rem;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .topbar {
        padding: 0.75rem 1rem;
    }

    .topbar-actions {
        gap: 0.5rem;
    }

    .topbar-actions [aria-haspopup="menu"] {
        min-width: 0;
        width: 2.75rem;
        justify-content: center;
    }

    .topbar-actions [aria-haspopup="menu"] span,
    .topbar-actions [aria-haspopup="menu"] svg {
        display: none;
    }

    .topbar-actions button[aria-label="Logout"] {
        display: none;
    }

    .page-header {
        display: grid;
    }

}

@media (prefers-reduced-motion: reduce) {
    .account-menu,
    .modal-overlay,
    .modal-panel {
        transition: none;
    }
}
