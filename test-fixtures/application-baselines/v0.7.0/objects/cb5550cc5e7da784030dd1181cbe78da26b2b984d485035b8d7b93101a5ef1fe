schema = 3
application = "baseline-application"

[framework]
repository = "https://github.com/furkancemalcaliskan/hegira.git"
version = "v0.7.0"

[selection]
databases = ["sqlite"]
clients = ["leptos"]

[composition]
capabilities = ["authentication", "authorization"]

[composition.package]
id = "hegira-canonical"
version = "v0.7.0"

[[composition.components]]
id = "identity"
version = "v0.7.0"

[[composition.components]]
id = "layered-base"
version = "v0.7.0"

[[composition.components]]
id = "layered-leptos-minimal"
version = "v0.7.0"

[[composition.modules]]
id = "identity"
version = "v0.7.0"

[upgrade.framework]
repository = "https://github.com/furkancemalcaliskan/hegira.git"
version = "v0.7.0"

[upgrade.package]
id = "hegira-canonical"
version = "v0.7.0"

[upgrade.ownership]
default = "application-owned"

[[upgrade.ownership.claims]]
path = "Cargo.lock"
class = "managed-integration"
integration = "framework-lockfile"

[[upgrade.ownership.claims]]
path = "Cargo.toml"
class = "managed-integration"
integration = "framework-dependencies"

[[upgrade.ownership.claims]]
path = "Dockerfile"
class = "generated-once"

[[upgrade.ownership.claims]]
path = "apps/server/src/server.rs"
class = "managed-integration"
integration = "resource-bearer-routes"

[[upgrade.ownership.claims]]
path = "apps/server/src/server.rs"
class = "managed-integration"
integration = "resource-leptos-contexts"

[[upgrade.ownership.claims]]
path = "apps/web/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "apps/web/src/routes.rs"
class = "managed-integration"
integration = "resource-routes-native"

[[upgrade.ownership.claims]]
path = "crates/application/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "crates/application_contracts/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "crates/domain/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/migrations/postgres"
class = "immutable-history"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/migrations/sqlite"
class = "immutable-history"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/src/config.rs"
class = "managed-integration"
integration = "module-config-fields"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/src/operations.rs"
class = "managed-integration"
integration = "module-migrations-postgres"

[[upgrade.ownership.claims]]
path = "crates/infrastructure/src/operations.rs"
class = "managed-integration"
integration = "module-migrations-sqlite"

[[upgrade.ownership.claims]]
path = "crates/presentation/src/lib.rs"
class = "managed-integration"
integration = "generated-modules"

[[upgrade.ownership.claims]]
path = "docker-compose.yml"
class = "generated-once"

[[upgrade.ownership.claims]]
path = "hegira.toml"
class = "managed-integration"
integration = "application-manifest"
