[package]
name = "app_web"
version.workspace = true
edition.workspace = true
license.workspace = true
rust-version.workspace = true
publish.workspace = true

[dependencies]
leptos.workspace = true
leptos_meta.workspace = true
leptos_router.workspace = true
web-sys = { version = "0.3.91", features = ["Document", "DomTokenList", "Element", "Storage", "Window"] }
identity_leptos = { workspace = true }

[features]
default = ["db-sqlite"]
db-postgres = ["identity_leptos/db-postgres"]
db-sqlite = ["identity_leptos/db-sqlite"]
hydrate = ["leptos/hydrate", "identity_leptos/hydrate"]
ssr = ["leptos/ssr", "leptos_meta/ssr", "leptos_router/ssr", "identity_leptos/ssr"]
wasm-split = ["identity_leptos/wasm-split"]

